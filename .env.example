UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token
ADMIN_TOKEN=replace-with-a-long-random-admin-token
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/weserads_crm
CRM_ADMIN_USERNAME=Admin
CRM_ADMIN_PASSWORD_HASH=replace-with-sha256-hash
CRM_SESSION_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
# Optional: set this explicitly if the production domain differs from the request host.
GOOGLE_CALENDAR_REDIRECT_URI=https://weserads.de/api/crm/calendar/oauth?action=callback
